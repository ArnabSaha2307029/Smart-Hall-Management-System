<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="#FFCDD2"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryTrxId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trx ID: --"
                android:textColor="#B71C1C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Paid on --/--/---- via bKash"
                android:textColor="#757575"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHistoryAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 BDT"
                android:textColor="#B71C1C"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadReceipt"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Receipt / PDF"
            android:textColor="#D32F2F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#D32F2F"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
