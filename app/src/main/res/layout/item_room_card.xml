<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FFCDD2"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardRoomId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Room 101"
                android:textColor="#B71C1C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardOccupancyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/4 Occupied"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_unpaid"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCardFloor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floor 1 • 4 Seats"
            android:textColor="#757575"
            android:textSize="12sp"
            android:layout_marginTop="3dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEBEE"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/badgeSeatA"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="A"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_unpaid" />

            <TextView
                android:id="@+id/badgeSeatB"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="B"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_unpaid" />

            <TextView
                android:id="@+id/badgeSeatC"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="C"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_unpaid" />

            <TextView
                android:id="@+id/badgeSeatD"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="D"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_unpaid" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
