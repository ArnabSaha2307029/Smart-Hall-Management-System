<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartHall">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:label="Admin Dashboard"
            android:parentActivityName=".ui.auth.LoginActivity" />

        <activity
            android:name=".ui.admin.StudentDetailActivity"
            android:exported="false"
            android:label="Student Detail"
            android:parentActivityName=".ui.admin.AdminDashboardActivity" />

        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="false"
            android:label="Student Dashboard"
            android:parentActivityName=".ui.auth.LoginActivity" />

    </application>

</manifest>
